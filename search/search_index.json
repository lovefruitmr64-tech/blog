cf\u7ea7\u5374\u529f\u80fd\u5f3a\u5927\u7684\u8de8\u5e73\u53f0\u6e90\u4ee3\u7801\u7f16\u8f91\u5668\uff0c\u7531\u5fae\u8f6f\u516c\u53f8\u5f00\u53d1\u3002\u5b83\u5185\u7f6e\u5bf9 JavaScript\u3001TypeScript \u548c Node.js \u7684\u652f\u6301\uff0c\u4e14\u901a\u8fc7\u4e30\u5bcc\u7684\u6269\u5c55\u751f\u6001\u7cfb\u7edf\uff0c\u53ef\u6ee1\u8db3\u591a\u79cd\u7f16\u7a0b\u8bed\u8a00\u7684\u5f00\u53d1\u9700\u6c42\u3002</p>","tags":["\u7f16\u7a0b"]},{"location":"blog/Illustrator/#_2","title":"\u8f6f\u4ef6\u4fe1\u606f","text":"<p>\u7248\u672c\uff1a</p> <p>Windows</p> <p>\u5927\u5c0f\uff1a</p> <p>197 MB</p>","tags":["\u7f16\u7a0b"]},{"location":"blog/Illustrator/#_3","title":"\u4e0b\u8f7d\u5730\u5740","text":"\u767e\u5ea6\u7f51\u76d8\u63d0\u53d6\u5bc6\u7801\uff1axxjj \u8fc5\u96f7\u4e0b\u8f7d\u63d0\u53d6\u5bc6\u7801\uff1axxjj \u963f\u91cc\u4e91\u76d8\u63d0\u53d6\u5bc6\u7801\uff1axxjj \u5938\u514b\u7f51\u76d8\u63d0\u53d6\u5bc6\u7801\uff1axxjj","tags":["\u7f16\u7a0b"]},{"location":"donate/","title":"\u6253\u8d4f\u6350\u8d60","text":""},{"location":"donate/#_2","title":"\u611f\u8c22\u60a8\u7684\u652f\u6301 \u2764\ufe0f","text":"<p>\u611f\u8c22\u60a8\u8bbf\u95ee\u7231\u679c\u6838\u8d44\u6e90\u5e93\uff01</p> <p>\u7231\u679c\u6838\u8d44\u6e90\u5e93\u4e00\u76f4\u81f4\u529b\u4e8e\u6536\u96c6\u3001\u6574\u7406\u548c\u5206\u4eab\u4f18\u8d28\u7684\u8f6f\u4ef6\u8d44\u6e90\u3001\u6280\u672f\u6559\u7a0b\u4ee5\u53ca\u5b9e\u7528\u5de5\u5177\u3002</p> <p>\u7f51\u7ad9\u7684\u7ef4\u62a4\u548c\u66f4\u65b0\u9700\u8981\u6295\u5165\u4e00\u5b9a\u7684\u65f6\u95f4\u6210\u672c\uff0c\u5305\u62ec\uff1a</p> <ul> <li>\u7f51\u7ad9\u7ef4\u62a4\uff1b</li> <li>\u5185\u5bb9\u6574\u7406\uff1b</li> <li>\u670d\u52a1\u5668\u53ca\u57df\u540d\u8d39\u7528\uff1b</li> <li>\u8d44\u6e90\u66f4\u65b0\u3002</li> </ul> <p>\u5982\u679c\u672c\u7ad9\u63d0\u4f9b\u7684\u5185\u5bb9\u5bf9\u60a8\u6709\u6240\u5e2e\u52a9\uff0c\u6b22\u8fce\u901a\u8fc7\u5fae\u4fe1\u626b\u7801\u652f\u6301\u672c\u7ad9\u3002</p> <p>\u60a8\u7684\u6bcf\u4e00\u6b21\u652f\u6301\uff0c\u90fd\u4f1a\u6210\u4e3a\u7231\u679c\u6838\u8d44\u6e90\u5e93\u6301\u7eed\u66f4\u65b0\u7684\u52a8\u529b\uff01</p> <p>\u611f\u8c22\u6bcf\u4e00\u4f4d\u652f\u6301\u672c\u7ad9\u53d1\u5c55\u7684\u670b\u53cb \u2764\ufe0f</p>"},{"location":"donate/#_3","title":"\u5fae\u4fe1\u626b\u7801\u6350\u8d60","text":"<p>\u611f\u8c22\u60a8\u7684\u652f\u6301\uff01</p> <p>\u626b\u7801\u540e\u8bf7\u8f93\u5165\u60a8\u5e0c\u671b\u652f\u6301\u7684\u91d1\u989d\u5373\u53ef\u3002</p>"},{"location":"donate/#_4","title":"\u6700\u65b0\u6350\u8d60\u540d\u5355","text":"<p>\u611f\u8c22\u4ee5\u4e0b\u670b\u53cb\u5bf9\u7231\u679c\u6838\u8d44\u6e90\u5e93\u7684\u652f\u6301\uff1a</p> \u5f20\u4e09  \u6350\u8d60\u91d1\u989d\uff1a8 \u5143  \u674e\u56db  \u6350\u8d60\u91d1\u989d\uff1a3 \u5143  \u5f20\u4e09  \u6350\u8d60\u91d1\u989d\uff1a8 \u5143  \u738b\u4f1f  \u6350\u8d60\u91d1\u989d\uff1a12 \u5143  \u5c0f\u660e  \u6350\u8d60\u91d1\u989d\uff1a5 \u5143  \u7528\u6237A  \u6350\u8d60\u91d1\u989d\uff1a10 \u5143  \u7528\u6237B  \u6350\u8d60\u91d1\u989d\uff1a6 \u5143  \u7528\u6237C  \u6350\u8d60\u91d1\u989d\uff1a20 \u5143"},{"location":"donate/#_5","title":"\u6350\u8d60\u8bf4\u660e","text":"<p>\u6240\u6709\u6350\u8d60\u5747\u4e3a\u7528\u6237\u81ea\u613f\u652f\u6301\u3002</p> <p>\u6350\u8d60\u8d44\u91d1\u4e3b\u8981\u7528\u4e8e\uff1a</p> <ul> <li>\u7f51\u7ad9\u957f\u671f\u7ef4\u62a4\uff1b</li> <li>\u670d\u52a1\u5668\u8d44\u6e90\uff1b</li> <li>\u7f51\u7ad9\u5185\u5bb9\u66f4\u65b0\uff1b</li> <li>\u8f6f\u4ef6\u8d44\u6e90\u6574\u7406\u3002</li> </ul> <p>\u7231\u679c\u6838\u8d44\u6e90\u5e93\u4e0d\u4f1a\u5f3a\u5236\u8981\u6c42\u7528\u6237\u6350\u8d60\uff0c\u6240\u6709\u5185\u5bb9\u4ecd\u4f1a\u6301\u7eed\u5f00\u653e\u3002</p> <p>\u518d\u6b21\u611f\u8c22\u6bcf\u4e00\u4f4d\u652f\u6301\u7231\u679c\u6838\u8d44\u6e90\u5e93\u7684\u670b\u53cb\uff01</p> <p>\u2764\ufe0f \u611f\u8c22\u60a8\u7684\u652f\u6301\uff01</p>"},{"location":"game/","title":"\u8f6f\u4ef6\u8d44\u6e90","text":"{% for post in blog.posts %}   {% if